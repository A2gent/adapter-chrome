{
  "manifest_version": 3,
  "name": "A2gent Brute Browser Adapter",
  "version": "0.1.0",
  "description": "Create and continue local Brute sessions from the current page (design mode), listen to articles aloud with HearHear (audio mode, default), or sync LinkedIn profiles into Brute person cards (sync mode).",
  "action": {
    "default_title": "A2gent: pick a mode",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/a2gent-16.png",
      "32": "icons/a2gent-32.png",
      "48": "icons/a2gent-48.png",
      "128": "icons/a2gent-128.png"
    }
  },
  "icons": {
    "16": "icons/a2gent-16.png",
    "32": "icons/a2gent-32.png",
    "48": "icons/a2gent-48.png",
    "128": "icons/a2gent-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://[::1]/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/pageHook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/drawingAnnotation.js",
        "src/contentDrawing.js",
        "src/contentUi.js",
        "src/contentScript/shared.js",
        "src/contentScript/sessionLaunch.js",
        "src/contentScript/projectMatching.js",
        "src/contentScript/diagnosticsHelpers.js",
        "src/contentScript/overlayFocus.js",
        "src/contentScript/drawingBridge.js",
        "src/contentScript/sessionEvents.js",
        "src/contentScript/caesarApi.js",
        "src/contentScript/pageDiagnostics.js",
        "src/contentScript/projectSettings.js",
        "src/contentScript/renderWiring.js",
        "src/contentScript.js",
        "src/browserControlBridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "dist/hearhear-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/peopleSync/linkedin.js",
        "src/peopleSync/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cursor.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    },
    {
      "resources": [
        "icons/a2gent-16.png"
      ],
      "matches": [
        "https://www.linkedin.com/*"
      ]
    }
  ],
  "options_page": "hearhear/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; media-src 'self' blob:; connect-src http://localhost:* http://127.0.0.1:* http://[::1]:* https://localhost:* https://127.0.0.1:* https://[::1]:*"
  }
}
